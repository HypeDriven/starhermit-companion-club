# The first club day played to its results by the hint (generated by
# tools/gen-play.mjs from js/rules.js): H, then the key the hint names.
until 300 =Play
frames 10
click =Play
until 60 Clubhouse floor
frames 10
expect Served 0/3
key KeyH 1
frames 3
key ArrowDown 1
frames 3
key KeyH 1
frames 3
key KeyS 1
frames 3
save club-day-moving
key KeyH 1
frames 3
key ArrowDown 1
frames 3
key KeyH 1
frames 3
key KeyS 1
frames 3
key KeyH 1
frames 3
key KeyT 1
frames 3
key KeyH 1
frames 3
key KeyT 1
frames 3
key KeyH 1
frames 3
key KeyS 1
frames 3
# 7 turns, 945 points
until 60 Club day complete!
frames 30
expect =945
expect Every wish on the club list was fulfilled in time.
save club-day-results
frames 10
click =Play again
until 60 Served 0/3
frames 10
save club-day-again
